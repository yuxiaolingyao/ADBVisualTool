{
  "name": "adb-visual-tool",
  "version": "0.1.0",
  "private": true,
  "description": "面向 Android 测试人员的可视化 ADB 工具",
  "main": "./out/main/index.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "electron-vite build && node tests/e2e/renderer-smoke.mjs",
    "e2e:electron": "electron-vite build && node tests/e2e/smoke.mjs",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-virtual": "3.14.24",
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "4.0.1",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
